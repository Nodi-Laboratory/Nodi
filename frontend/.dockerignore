# 빌드 컨텍스트에서 뺀다. node_modules·.next는 이미지 안에서 새로 만든다
# (호스트의 것은 OS가 달라 네이티브 바이너리가 안 맞는다 — 윈도우 → alpine).
# .env*는 절대 넣지 않는다: NEXT_PUBLIC_*가 번들에 인라인돼 새어 나간다.
node_modules/
.next/
out/
coverage/
test-results/
playwright-report/
e2e/
.env
.env.*
*.log
*.tsbuildinfo
next-env.d.ts
Dockerfile
.dockerignore
