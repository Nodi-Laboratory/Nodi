# nodi 프론트엔드 환경 변수 예시
#
# 사용법: 이 파일을 `frontend/.env.local`로 복사한 뒤 값을 채운다.
# `.env.local`은 gitignored다 (frontend/.gitignore의 `.env*`).
#
# ⚠️ 키를 여기에 박아두지 않는다. 과거에는 실제 anon 키가 이 파일에 커밋돼
#    있었는데, 프로젝트가 신규 publishable 키 포맷으로 이전한 뒤에도 예시만
#    옛 레거시 JWT(eyJ...)로 남아 그대로 복사한 사람이 조용히 어긋났다.

# --- Supabase (브라우저 노출 — publishable/anon 키만) ---
# Supabase 대시보드 > Settings > API Keys 에서 복사한다.
# backend/.env 의 SUPABASE_URL / SUPABASE_ANON_KEY 와 **같은 값**을 쓴다.
NEXT_PUBLIC_SUPABASE_URL=          # 예: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # sb_publishable_... (신규 포맷)

# --- 백엔드 FastAPI (REST + SSE) ---
# 로컬 개발은 백엔드를 직접 호출한다.
# (프로덕션 VM은 next.config.ts의 /api rewrite로 서버사이드 프록시 — docs/DEPLOYMENT.md)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
