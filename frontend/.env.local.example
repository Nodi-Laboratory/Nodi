# nodi 프론트엔드 환경 변수 예시
#
# 사용법: 이 파일을 `frontend/.env.local`로 복사한다.
# `.env.local`은 gitignored다 (frontend/.gitignore의 `.env*`).
#
# 프론트는 DB에 직접 접근하지 않고 모든 요청이 백엔드를 거친다 — 브라우저에
# 노출할 자격증명 자체가 없다.

# --- 백엔드 FastAPI (REST + SSE) ---
# 백엔드 도메인 라우터가 전부 /api 아래에 있다(D105). **같은 출처 `/api`로 둔다** —
# 세션이 httpOnly 쿠키라, 브라우저가 다른 출처(:8000 직접)로 보내면 쿠키가 안
# 실려 로그인이 안 된다. next.config.ts의 rewrite가 `/api` → BACKEND_ORIGIN으로
# 넘긴다(기본 http://localhost:8000 — 다른 포트면 BACKEND_ORIGIN을 준다).
NEXT_PUBLIC_API_BASE_URL=/api

# --- 펜 입력(손글씨 OCR) (D176) ---
# 프롬프트창의 펜 버튼. 기본은 **켬**이다 — 백엔드 창구(POST /api/ocr/handwriting)가
# 없거나 모델 서버가 미설정이면(404/501) "준비하고 있어요"로 안내한다.
# 모델 서버 주소는 백엔드가 갖는다(backend/.env의 OCR_BASE_URL — 보통 비워 둔다).
# 펜 버튼 자체를 감추려면 아래 줄의 주석을 푼다.
# NEXT_PUBLIC_HANDWRITING_OCR=off
