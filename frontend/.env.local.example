# nodi 프론트엔드 환경 변수 예시
#
# 사용법: 이 파일을 `frontend/.env.local`로 복사한다.
# `.env.local`은 gitignored다 (frontend/.gitignore의 `.env*`).
#
# D104: Supabase를 걷어내면서 **필요한 값이 하나로 줄었다.** 프론트는 더 이상
# DB에 직접 접근하지 않고 모든 요청이 백엔드를 거친다 — 브라우저에 노출할
# 자격증명 자체가 없다(구성에서는 anon 키를 실어야 했다).

# --- 백엔드 FastAPI (REST + SSE) ---
# D105: 백엔드 도메인 라우터가 전부 /api 아래에 있다. 로컬은 백엔드를 직접
# 호출하고, 프로덕션은 next.config.ts의 rewrite가 같은 경로를 그대로 프록시한다
# (`/api` → `:8000/api`) — 양쪽 경로가 같다. 프로덕션 값은 `/api` 한 줄이면 된다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- 펜 입력(손글씨 OCR) (D176) ---
# 프롬프트창의 펜 버튼. 기본은 **켬**이다 — 백엔드 창구(POST /api/ocr/handwriting)가
# 없거나 모델 서버가 미설정이면(404/501) "준비하고 있어요"로 안내한다.
# 모델 서버 주소는 백엔드가 갖는다(backend/.env의 OCR_BASE_URL — 보통 비워 둔다).
# 펜 버튼 자체를 감추려면 아래 줄의 주석을 푼다.
# NEXT_PUBLIC_HANDWRITING_OCR=off
