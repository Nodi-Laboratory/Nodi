# 로컬 Supabase 스택(`supabase start`)용 백엔드 설정 예시 (D98)
#
# 사용법: `backend/.env`에 아래 Supabase 3종을 덮어쓴다. 나머지 키(Upstage·
# EXAONE)는 원격/로컬 공통이므로 backend/.env.example 을 그대로 따른다.
#
# ⚠️ 아래 키들은 Supabase CLI가 모든 로컬 스택에 쓰는 **공개 고정값**이다.
#    비밀이 아니며 로컬에서만 유효하다. 실제 값은 `npx supabase status`로
#    언제든 다시 확인할 수 있다.
#
# 원격 프로젝트로 되돌리려면 이 3개를 원래 값으로 바꾸면 된다 — 그 외에는
# 코드도 마이그레이션도 동일하다.

# 로컬 스택 API 게이트웨이(Kong). 포트는 supabase/config.toml의 [api] port.
SUPABASE_URL=http://127.0.0.1:54321

# 로컬 스택 고정 anon 키 (레거시 JWT 포맷 — CLI가 발급)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 로컬 스택 고정 service_role 키
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# 로컬은 프로젝트 ref가 없다 — 비워 두면 SUPABASE_URL에서 JWKS를 파생한다.
SUPABASE_PROJECT_REF=
SUPABASE_JWKS_URL=
