# nodi backend — 환경 변수 예시
#
# 사용법: 이 파일을 같은 폴더의 `backend/.env`로 복사한 뒤 값을 채운다.
#
#   cp backend/.env.example backend/.env      # PowerShell: copy backend\.env.example backend\.env
#
# ⚠️ 위치 주의: 백엔드는 **`backend/.env`**를 읽는다 (저장소 루트 `.env` 아님).
#    app/config.py 의 BACKEND_ENV 참조. 루트에 두면 값이 하나도 안 읽히는데
#    서버는 정상 부팅하므로(키 없이 부팅하도록 설계) 원인을 찾기 어렵다.
#
# 채운 뒤 확인: 서버를 띄우고 http://localhost:8000/health/config 를 연다.
#    `"ready": true` 면 채팅 한 턴에 필요한 설정이 다 갖춰진 것이다.
#    `blocking` 배열에 남은 항목이 있으면 그게 아직 빠진 것이다.
#
# `backend/.env`는 gitignored다. 실제 키를 이 예시 파일에 적지 말 것.

# ============================================================================
# 필수 — 이 3개가 없으면 앱이 기능하지 않는다
# ============================================================================

# --- Postgres (D104) ---
# docker compose의 postgres 서비스(5433). 두 DSN은 **역할이 다르다**:
#   nodi_app    RLS 적용 — 사용자 요청 경로
#   nodi_worker BYPASSRLS — 백그라운드 워커·인증
# WORKER 미설정 시 파일 업로드·임베딩 워커가 전부 503.
DATABASE_URL=postgresql://nodi_app:nodi_app_dev@localhost:5433/nodi
DATABASE_WORKER_URL=postgresql://nodi_worker:nodi_worker_dev@localhost:5433/nodi

# --- 자체 인증 ---
# 액세스 토큰(HS256) 서명 키. **운영에서는 반드시 교체한다** — 기본값이면
# 누구나 토큰을 위조할 수 있다(부팅 시 경고, /health/config에서도 표시).
JWT_SECRET=dev-only-change-me

# --- Upstage (임베딩 1024d + 문서 파싱·업로드 + 대화 생성 폴백) ---
# 2026-11-17 "모두 gemini로": 대화 생성·도구 판단·소형 LLM 작업은 **GEMINI_API_KEY가
# 있으면 Gemini**가 맡는다(아래 "대화 생성 모델"). 이 키는 그 밖의 일 — 문서
# 파싱·업로드 임베딩 — 에 필요하고, Gemini 키가 없는 서버(대회 운영 배포)에서는
# 대화 생성도 여전히 이 키의 solar가 맡는다. 즉 **Gemini 키가 없으면 이 키가
# 빠질 때 채팅도 RAG도 전부 멈춘다.** 업로드는 .env 키 전용(헤더 키는 워커에 안 닿는다).
UPSTAGE_API_KEY=                 # up_...

# ============================================================================
# 선택 — 기본값이 있거나, 특정 기능에만 필요
# ============================================================================

# --- Qdrant (벡터 저장소) ---
# 로컬은 `docker compose up -d qdrant` 후 기본값 그대로 두면 된다.
QDRANT_URL=http://localhost:6333

# --- 대화 생성 모델 ---
# 공급자는 호출마다 정해진다(services/solar.py resolve_route):
#   1) Gemini 키가 있으면(.env 먼저, 없으면 앱에서 입력한 헤더 키) → Gemini
#   2) 아니면 Upstage 키로 → Upstage (기존 동작 그대로)
# Gemini는 OpenAI 호환 엔드포인트로 부른다(스트리밍·tool calling 모두 지원).
# 사고(thinking) 모델이라 지연을 줄이려 기본 강도는 minimal이다 — 모델이 거절하면
# 자동으로 low → 생략 순으로 물러난다. Pro 계열은 쓰지 않는다.
# GEMINI_CHAT_MODEL=gemini-3.5-flash         # 답변 생성 + 도구 판단
# GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite   # 소형 작업(질문 코치·개념 연결 판정)
# GEMINI_REASONING_EFFORT=minimal            # minimal | low | medium | high
# Upstage 폴백 갈래(Gemini 키가 없을 때). tool calling과 스트리밍이 모두 필요하다 —
# 둘 중 하나라도 없는 모델을 넣으면 ReAct 판단 단계나 SSE 스트림이 깨진다.
# UPSTAGE_CHAT_MODEL=solar-pro3
# CHAT_TEMPERATURE=0.5
# CHAT_MAX_TOKENS=2048

# --- Gemini (비전: 도판 캡션·손글씨·펜 표시 해석 + 대화 생성) — 공개판 기본 경로 ---
#
# 사용자 결정(2026-09-27): 비전·손글씨 인식은 Gemini API로 한다.
# 비워두면 앱에서 직접 입력 — 사용자가 화면에서 자기 키와 모델을 넣으면 그 요청
# 동안만 쓰인다(서버에 저장하지 않는다). 채우면 그 키만 쓰고 화면 입력은 무시한다.
# ⚠️ 교과서 도판 캡션은 업로드 뒤 워커에서 돌아 화면 입력 키가 닿지 않는다 —
#    도판 캡션까지 쓰려면 여기에 키를 넣는다(또는 아래 JUDGE_* 자체 호스팅).
GEMINI_API_KEY=                  # 비워두면 앱에서 직접 입력
# 너무 높은 모델은 쓰지 않는다(Pro 계열 제외). 앱 화면에서 고를 수 있는 목록:
#   gemini-3.5-flash-lite (기본) · gemini-3.1-flash-lite · gemini-3.5-flash · gemini-3.6-flash
# GEMINI_API_KEY를 채웠을 때만 이 값이 쓰인다.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# --- 임베딩 제공자 (2026-11-17 "모두 gemini로") ---
# **키 유무가 아니라 이 설정이 정한다** — 색인과 질의의 제공자가 갈리면 두 벡터가 서로
# 다른 공간이라 검색이 오류 없이 빈손이 된다. 기본 upstage(이미 Upstage 벡터가 든
# 서버는 그대로). 공개 배포는 gemini로 둔다(GEMINI_API_KEY 필요 — **워커는 .env 키만
# 본다**: 업로드 임베딩은 헤더 키가 닿지 않는다). 문서 파싱(업로드)은 어느 쪽이든
# Upstage다 — Gemini에 대응 API가 없다.
# ⚠️ 이미 색인된 DB·Qdrant에서 바꾸면 기존 벡터와 공간이 달라진다 — 전량 재임베딩
#    (또는 빈 Qdrant)이 전제다. 거리 게이트는 제공자마다 기본값이 따로다
#    (config.GEMINI_GATE_DEFAULTS: 학급 자료·도판·클립 0.36 / 원자 0.25 / 연결 띠 0.27~0.43,
#    Upstage는 0.60 / 0.45 / 0.42~0.66). DB 행이 null이면 이 기본값을 따르고,
#    CLASS_MATERIAL_RAG_MAX_DISTANCE 같은 env로 덮을 수 있다.
# 데모 시드도 제공자별 벡터 파일을 쓴다(app/seed_demo/assets/vectors[.gemini].json.gz) —
# 런타임 제공자와 맞는 파일만 올리고 어긋나면 경고 후 건너뛴다.
# EMBEDDING_PROVIDER=gemini            # upstage(기본) | gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # 1024d로 요청해 L2 정규화한다

# ============================================================================
# 아래 JUDGE_*·OCR_*는 **선택 사항 — 자체 호스팅(legacy) 예비 경로**다.
# Gemini 키(.env 또는 앱 입력)가 없을 때만 쓰인다. 대회 운영 배포는 규정상
# 해외 모델을 못 써서 이 경로(EXAONE·VARCO)로 돈다. 공개판은 비워 둬도 된다.
# ============================================================================

# --- 교과서 figure 캡션 판정 (VLM) — 선택 사항, legacy 자체 호스팅 ---
#
# D103: **비워 둬도 된다.** 캡션은 먼저 파서가 caption/footnote로 라벨한 요소에서
#    가져오고(비전 모델 불필요), 판정은 라벨이 없는 도판을 건지는 **폴백**이다.
#    미설정이면 교과서 업로드는 그대로 되고, 라벨 없는 도판만 처리되지 않는다.
#    (D93에서는 판정이 유일한 캡션 출처라 미설정 시 업로드를 503으로 막았다.)
#
# ⚠️ D97: JUDGE_BASE_URL에는 기본값이 없다 — 쓸 거면 반드시 명시한다.
#    (과거 기본값은 TTA 게이트웨이 30099를 가리켰으나, 그 포트는 프론트엔드로
#     용도가 바뀌었다. 키만 채우면 비전 요청이 엉뚱한 서비스로 날아갔다.)
#
# ⚠️ 살아있지 않은 주소를 넣지 말 것. 설정만 채워져 있으면 게이트는 통과하는데
#    실제 호출이 전부 실패해 도판이 조용히 사라진다. 쓸 게 없으면 비워 두는 것이
#    낫다 — 그 경우 파서 라벨 경로만 동작한다.
#
# OpenAI 호환 비전 엔드포인트면 무엇이든 꽂을 수 있다. 단 요청 파라미터가
# EXAONE 4.5 실측값(chat_template_kwargs.enable_thinking 등)이라 다른 모델에서는
# 무시되거나 400이 날 수 있어 검증이 필요하다 — services/figure_judge.py 참조.
# JUDGE_MODEL은 엔드포인트가 아는 이름이어야 한다. 운영 서버는 llama.cpp를
# `--alias exaone-4.5-33b`로 띄우므로 그 값이 들어간다(D118 — deploy/config.sh의
# JUDGE_MODEL_ALIAS와 한 쌍이고, bootstrap.sh가 둘을 맞춰 준다).
JUDGE_API_KEY=
JUDGE_BASE_URL=                  # 예: http://127.0.0.1:8080/v1
JUDGE_MODEL=EXAONE-4.5-33B

# --- 손글씨 OCR (D176) — 선택 사항, legacy 자체 호스팅 ---
#
# 프롬프트창의 펜 입력판이 쓴 글씨를 보내는 곳(VARCO-VISION-2.0-1.7B-OCR 서버).
# 미설정이어도 채팅은 정상이고, 펜 입력만 "준비 중"으로 안내된다(501).
#
# **명시하는 쪽을 권한다.** 비워 두면 JUDGE_BASE_URL의 호스트에 OCR_PORT를
# 붙여 유도하는데(두 모델이 같은 기계의 다른 GPU에 있다는 전제), 그 전제가
# 깨지는 순간 조용히 엉뚱한 데로 나간다:
#
#   비전 모델을 다른 기계로 옮기거나 외부 주소로 바꾸면 → OCR도 따라 나간다
#   → 손글씨 인식이 통째로 죽는데 화면에는 "준비하고 있어요"(501)로만 보인다
#   → **기능이 아직 안 만들어진 것처럼 보인다.**
#
# 실제로 한 번 그랬다(D177: `All connection attempts failed`로 프로덕션에서
# 죽어 있었다). 두 주소는 서로 무관하므로 엮어 두지 않는다.
# 공개판은 비워 둔다 — 없는 서버를 가리키면 Gemini 키가 없을 때 "준비 중"(501)
# 대신 "서버가 응답하지 않음"(502)이 뜬다.
OCR_BASE_URL=                    # 예: http://127.0.0.1:8083 (끝에 /ocr 붙이지 않는다)
# OCR_PORT=8083                  # 유도할 때 붙일 포트(내부 포트다 — D177)
# OCR_ENABLED=true               # 모델 서버 점검 중 끄는 스위치
# OCR_MAX_NEW_TOKENS=512         # 질문 한 줄이면 충분(요청은 GPU 락으로 직렬 처리)
# OCR_TIMEOUT_SECONDS=90         # 실측 6~8초 + 직렬 대기

# --- 앱 (기본값이 합리적 — 보통 건드리지 않는다) ---
# ENVIRONMENT=development
# JWT_AUDIENCE=authenticated
# JWT_EXPIRE_MINUTES=720          # 토큰 만료(기본 12시간 — 수업 한 타임 여유)
# STORAGE_ROOT=                   # 업로드 파일 저장 위치(기본 backend/.storage)
# STORAGE_SIGN_SECRET=            # signed URL 서명 키(비우면 JWT_SECRET 공용)
