# nodi backend — environment variables
#
# NOTE: The backend reads the REPOSITORY ROOT `.env` (one level above backend/),
# not this file. This file only DOCUMENTS the keys the backend expects.
# Put real values in the root `.env` (which is gitignored). Never commit secrets.
#
# pydantic-settings (app/config.py) loads `<repo-root>/.env`.

# --- EXAONE / Friendli (chat-answer generation) ---
# Friendli serverless endpoint, OpenAI-compatible. Replaces Gemini for chat.
EXAONE_API_KEY=         # Friendli API key (starts with flp_)
# EXAONE_MODEL=LGAI-EXAONE/K-EXAONE-236B-A23B  # optional override (serverless model id)
# 전용(dedicated) 엔드포인트 ID. 설정하면 /dedicated/v1로 요청(예약 GPU → 공유 rate limit 없음).
# 비우면 serverless로 요청. Friendli 대시보드에서 엔드포인트 생성 후 ID를 넣는다.
# EXAONE_ENDPOINT_ID=
# FRIENDLI_BASE_URL=https://api.friendli.ai   # optional override

# --- Google Gemini (embeddings ONLY: SVG art search + concept grouping) ---
# Chat now runs on EXAONE; Gemini is kept only for embeddings (no EXAONE embed).
GOOGLE_GEMINI_API_KEY=

# --- Anthropic / Claude (OFFLINE SVG art generation script only) ---
# Used by backend/scripts/generate_art.py to pre-generate the SVG library.
ANTHROPIC_API_KEY=

# --- Supabase ---
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Project ref (the <ref> subdomain), e.g. ahmhccmmhujbgnrktavx
SUPABASE_PROJECT_REF=
# JWKS endpoint for ES256 token verification.
# Optional: if empty, derived as ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Public anon key (Settings > API). Used with the user's JWT for RLS-scoped reads.
SUPABASE_ANON_KEY=
# Service-role key (Settings > API). Optional in Stage 0 — server can boot without it.
# Required later for privileged server-side operations. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- App (optional; sensible defaults in app/config.py) ---
# ENVIRONMENT=development
# JWT_AUDIENCE=authenticated
