# nodi backend — 환경 변수 예시
#
# 사용법: 이 파일을 같은 폴더의 `backend/.env`로 복사한 뒤 값을 채운다.
#
#   cp backend/.env.example backend/.env      # PowerShell: copy backend\.env.example backend\.env
#
# ⚠️ 위치 주의: 백엔드는 **`backend/.env`**를 읽는다 (저장소 루트 `.env` 아님).
#    app/config.py 의 BACKEND_ENV 참조. 루트에 두면 값이 하나도 안 읽히는데
#    서버는 정상 부팅하므로(키 없이 부팅하도록 설계) 원인을 찾기 어렵다.
#
# 채운 뒤 확인: 서버를 띄우고 http://localhost:8000/health/config 를 연다.
#    `"ready": true` 면 채팅 한 턴에 필요한 설정이 다 갖춰진 것이다.
#    `blocking` 배열에 남은 항목이 있으면 그게 아직 빠진 것이다.
#
# `backend/.env`는 gitignored다. 실제 키를 이 예시 파일에 적지 말 것.

# ============================================================================
# 필수 — 이 3개가 없으면 앱이 기능하지 않는다
# ============================================================================

# --- Postgres (D104: Supabase 제거) ---
# docker compose의 postgres 서비스(5433). 두 DSN은 **역할이 다르다**:
#   nodi_app    RLS 적용 — 사용자 요청 경로
#   nodi_worker BYPASSRLS — 백그라운드 워커·인증(구 service_role 대응)
# WORKER 미설정 시 파일 업로드·임베딩 워커가 전부 503.
DATABASE_URL=postgresql://nodi_app:nodi_app_dev@localhost:5433/nodi
DATABASE_WORKER_URL=postgresql://nodi_worker:nodi_worker_dev@localhost:5433/nodi

# --- 자체 인증 ---
# 액세스 토큰(HS256) 서명 키. **운영에서는 반드시 교체한다** — 기본값이면
# 누구나 토큰을 위조할 수 있다(부팅 시 경고, /health/config에서도 표시).
JWT_SECRET=dev-only-change-me

# --- Upstage (대화 생성 + 임베딩 1024d + 문서 파싱) ---
# D108: 대화 생성까지 Upstage로 모였다. **이 키 하나가 빠지면 채팅도 RAG도
# 전부 멈춘다** (예전에는 EXAONE 키와 나뉘어 있어 한쪽만 죽었다).
UPSTAGE_API_KEY=                 # up_...

# ============================================================================
# 선택 — 기본값이 있거나, 특정 기능에만 필요
# ============================================================================

# --- Qdrant (벡터 저장소) ---
# 로컬은 `docker compose up -d qdrant` 후 기본값 그대로 두면 된다.
QDRANT_URL=http://localhost:6333

# --- 대화 생성 모델 ---
# 기본 solar-pro3(2026-08-04 변경). tool calling과 스트리밍이 모두 필요하다 —
# 둘 중 하나라도 없는 모델을 넣으면 ReAct 판단 단계나 SSE 스트림이 깨진다.
# 되돌리려면 아래 줄의 주석을 풀고 solar-pro2로 둔다.
# UPSTAGE_CHAT_MODEL=solar-pro3
# CHAT_TEMPERATURE=0.5
# CHAT_MAX_TOKENS=2048

# --- 교과서 figure 캡션 판정 (VLM) — 선택 사항 ---
#
# D103: **비워 둬도 된다.** 캡션은 먼저 파서가 caption/footnote로 라벨한 요소에서
#    가져오고(비전 모델 불필요), 판정은 라벨이 없는 도판을 건지는 **폴백**이다.
#    미설정이면 교과서 업로드는 그대로 되고, 라벨 없는 도판만 처리되지 않는다.
#    (D93에서는 판정이 유일한 캡션 출처라 미설정 시 업로드를 503으로 막았다.)
#
# ⚠️ D97: JUDGE_BASE_URL에는 기본값이 없다 — 쓸 거면 반드시 명시한다.
#    (과거 기본값은 TTA 게이트웨이 30099를 가리켰으나, 그 포트는 프론트엔드로
#     용도가 바뀌었다. 키만 채우면 비전 요청이 엉뚱한 서비스로 날아갔다.)
#
# ⚠️ 살아있지 않은 주소를 넣지 말 것. 설정만 채워져 있으면 게이트는 통과하는데
#    실제 호출이 전부 실패해 도판이 조용히 사라진다. 쓸 게 없으면 비워 두는 것이
#    낫다 — 그 경우 파서 라벨 경로만 동작한다.
#
# OpenAI 호환 비전 엔드포인트면 무엇이든 꽂을 수 있다. 단 요청 파라미터가
# EXAONE 4.5 실측값(chat_template_kwargs.enable_thinking 등)이라 다른 모델에서는
# 무시되거나 400이 날 수 있어 검증이 필요하다 — services/figure_judge.py 참조.
# JUDGE_MODEL은 엔드포인트가 아는 이름이어야 한다. 운영 서버는 llama.cpp를
# `--alias exaone-4.5-33b`로 띄우므로 그 값이 들어간다(D118 — deploy/config.sh의
# JUDGE_MODEL_ALIAS와 한 쌍이고, bootstrap.sh가 둘을 맞춰 준다).
JUDGE_API_KEY=
JUDGE_BASE_URL=                  # 예: http://127.0.0.1:8080/v1
JUDGE_MODEL=EXAONE-4.5-33B

# --- 손글씨 OCR (D176) — 선택 사항 ---
#
# 프롬프트창의 펜 입력판이 쓴 글씨를 보내는 곳(VARCO-VISION-2.0-1.7B-OCR 서버).
# 미설정이어도 채팅은 정상이고, 펜 입력만 "준비 중"으로 안내된다(501).
#
# **보통은 비워 둔다.** 비어 있으면 JUDGE_BASE_URL의 호스트에 OCR_PORT(30020)를
# 붙여 유도한다 — 두 모델이 같은 기계의 다른 GPU에 떠 있기 때문이다(비전 GPU0,
# OCR GPU1). 배포마다 IP를 두 번 적으면 한쪽만 바뀐 채 남는다.
# 다른 기계로 옮길 때만 아래를 명시한다.
# OCR_BASE_URL=                  # 예: http://127.0.0.1:8083 (끝에 /ocr 붙이지 않는다)
# OCR_PORT=30020                 # 유도할 때 붙일 포트
# OCR_ENABLED=true               # 모델 서버 점검 중 끄는 스위치
# OCR_MAX_NEW_TOKENS=512         # 질문 한 줄이면 충분(요청은 GPU 락으로 직렬 처리)
# OCR_TIMEOUT_SECONDS=90         # 실측 6~8초 + 직렬 대기

# --- 앱 (기본값이 합리적 — 보통 건드리지 않는다) ---
# ENVIRONMENT=development
# JWT_AUDIENCE=authenticated
# JWT_EXPIRE_MINUTES=720          # 토큰 만료(기본 12시간 — 수업 한 타임 여유)
# STORAGE_ROOT=                   # 업로드 파일 저장 위치(기본 backend/.storage)
# STORAGE_SIGN_SECRET=            # signed URL 서명 키(비우면 JWT_SECRET 공용)
