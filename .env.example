# Nodi — docker compose 환경 변수 (공개판)
#
#   cp .env.example .env && docker compose up -d
#
# **아무것도 안 고쳐도 뜬다.** 아래 기본값은 로컬 체험용이다. 인터넷에 여는
# 서버라면 JWT_SECRET과 세 비밀번호를 반드시 바꾸고 SEED_DEMO=false로 둔다.
# 이 파일은 커밋되는 예시다 — 실제 키는 복사한 `.env`(gitignored)에만 적는다.

# ---------------------------------------------------------------------------
# 인증 토큰 서명 키 — **공개 배포 전에 반드시 바꾼다.**
# 기본값이면 누구나 로그인 토큰을 위조할 수 있다. 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-change-me

# ---------------------------------------------------------------------------
# Postgres 비밀번호
#   POSTGRES_PASSWORD        슈퍼유저(postgres). 스키마·마이그레이션 적용에만 쓴다
#   NODI_APP_DB_PASSWORD     nodi_app — 사용자 요청 경로(RLS 적용)
#   NODI_WORKER_DB_PASSWORD  nodi_worker — 워커·인증(BYPASSRLS)
# 역할 비밀번호는 migrate 서비스가 기동마다 이 값으로 맞춘다(나중에 바꿔도 된다).
# POSTGRES_PASSWORD만은 **볼륨을 처음 만들 때** 정해진다 — 바꾸려면 down -v.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres
NODI_APP_DB_PASSWORD=nodi_app_dev
NODI_WORKER_DB_PASSWORD=nodi_worker_dev

# 브라우저로 여는 포트 → http://localhost:3000
APP_PORT=3000

# 데모 계정(demo / demo1234)과 예시 데이터를 처음 한 번 만든다(이미 있으면 건너뜀).
# 로컬 체험용이다 — 값이 true일 때만 돈다. 공개 서버에서는 false로 둔다.
SEED_DEMO=true

# ---------------------------------------------------------------------------
# AI API 키 — 비워두면 앱에서 직접 입력
# 화면(설정)에서 방문자가 넣은 키는 요청마다 헤더로만 오가고 서버에 저장되지
# 않는다. 여기 적으면 모든 방문자가 이 키를 쓴다. 교과서 업로드·임베딩 같은
# 백그라운드 작업은 화면 키를 못 쓰므로 그 기능을 쓰려면 여기 넣는다.
#
#   Upstage (대화 생성·임베딩·문서 파싱)  https://console.upstage.ai/api-keys
#   Gemini  (도판 캡션·손글씨 인식)        https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
UPSTAGE_API_KEY=
GEMINI_API_KEY=

# Gemini 비전 모델. 허용: gemini-3.5-flash-lite · gemini-3.1-flash-lite ·
#                       gemini-3.5-flash · gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
