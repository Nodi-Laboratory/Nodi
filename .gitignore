# Claude 비공개 작업 공간 (절대 커밋하지 않음)
.claude/

# 환경 변수 / 비밀 키
.env
.env.*
# 예시 템플릿만 예외 — 실제 키가 아니라 채우는 방법을 적은 파일이다.
# `.env.*` 패턴이 `.env.local.example`까지 삼키므로 `*.example`로 열어 준다
# (frontend/.gitignore도 같은 이유로 !.env.local.example을 두고 있다).
!*.env.example
!.env.example
!.env.*.example

# Node (저장소 어디서 npm/npx를 돌리든)
# frontend/.gitignore의 `/node_modules`는 그 폴더에만 걸린다. 루트에서 `npx`를
# 한 번 돌리면 루트에 node_modules가 생기고 `git status`에 뜬다 — 누가 한 번
# `git add -A`를 하면 수만 파일이 딸려 들어간다.
node_modules/

# Python (backend)
.venv/
backend/.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Qdrant 로컬 볼륨 (docker-compose)
qdrant_storage/

# Qdrant 바이너리 (샌드박스: docker-in-docker 불가로 바이너리 직접 실행, D-없음 임시)
.qdrant-bin/

# 프로세스 백그라운드 실행 로그 (nohup, 로컬 상태 — 커밋 금지)
*.log

# OS / 에디터
Thumbs.db
.DS_Store
.superpowers/

# Serena MCP 로컬 상태 (LSP 캐시·프로젝트 설정 — 로컬 도구 상태, 커밋 금지)
.serena/

# MCP 서버 설정 (로컬 도구 구성 — 커밋 금지)
.mcp.json

# playwright-cli 세션 상태 (스냅샷·세션 데이터 — 로컬 도구 상태, 커밋 금지)
.playwright-cli/


# 로컬 파일 저장소 (D104: 구 Supabase Storage 대체 — 업로드 파일)
backend/.storage/
